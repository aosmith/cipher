    let (alice, _) = alice_db.create_user_first_launch("alice".to_string(), Database::generate_device_id()).unwrap();
    let (bob, _) = bob_db.create_user_first_launch("bob".to_string(), Database::generate_device_id()).unwrap();

    // Alice generates QR code
    let alice_qr = alice_db.generate_friend_qr_code(alice.id).unwrap();

    // Bob scans Alice's QR code
    let result = bob_db.add_friend_from_qr_code(bob.id, &alice_qr);
    assert!(result.is_ok(), "Adding friend from QR code should succeed");

    // Verify friendship
    let bob_friends = bob_db.get_friends(bob.id).unwrap();
    assert_eq!(bob_friends.len(), 1);
    assert_eq!(bob_friends[0].public_key, alice.public_key);
}

#[test]
fn test_friends_of_friends() {
    let temp_dir = TempDir::new().unwrap();
    let db = Database::new(&temp_dir.path().join("test.db").to_string_lossy()).unwrap();

    let (alice, _) = db.create_user_first_launch("alice".to_string(), Database::generate_device_id()).unwrap();
    let (bob, _) = db.create_user_first_launch("bob".to_string(), Database::generate_device_id()).unwrap();
    let (charlie, _) = db.create_user_first_launch("charlie".to_string(), Database::generate_device_id()).unwrap();

    // Alice <-> Bob (friends)
    db.add_friend(alice.id, bob.id).unwrap();
    db.add_friend(bob.id, alice.id).unwrap();

    // Bob <-> Charlie (friends)
    db.add_friend(bob.id, charlie.id).unwrap();
    db.add_friend(charlie.id, bob.id).unwrap();

    // Mark friendships as accepted
    db.conn.lock().unwrap().execute(
        "UPDATE p2p_connections SET status = 'accepted'",
        []
    ).unwrap();

    // Alice queries friends-of-friends
    let fof = db.get_friends_of_friends(alice.id).unwrap();

    // Charlie should appear as friend-of-friend (through Bob)
    let charlie_appears = fof.iter().any(|u| u.id == charlie.id);
    assert!(charlie_appears, "Charlie should be Alice's friend-of-friend");
}

#[test]
#[ignore = "export_friends_list and import_friends_list APIs not implemented yet"]
fn test_export_import_friends_list() {
    let temp_dir1 = TempDir::new().unwrap();
    let device1_db = Database::new(&temp_dir1.path().join("device1.db").to_string_lossy()).unwrap();

    let (user, _) = device1_db.create_user_first_launch("alice".to_string(), Database::generate_device_id()).unwrap();

    // Add some friends
    let (bob, _) = device1_db.create_user_first_launch("bob".to_string(), Database::generate_device_id()).unwrap();
    let (charlie, _) = device1_db.create_user_first_launch("charlie".to_string(), Database::generate_device_id()).unwrap();

    device1_db.add_friend(user.id, bob.id).unwrap();
    device1_db.add_friend(user.id, charlie.id).unwrap();

    // Export friends list
    let export_json = device1_db.export_friends_list(user.id).unwrap();
    assert!(export_json.len() > 0);

    // Import on new device
    let temp_dir2 = TempDir::new().unwrap();
    let device2_db = Database::new(&temp_dir2.path().join("device2.db").to_string_lossy()).unwrap();

    // Restore user with same recovery phrase (same user_id)
    let device2_db_inner = device2_db.import_friends_list(user.id, &export_json);
    assert!(device2_db_inner.is_ok(), "Import should succeed");

    // Verify friends exist
    let friends = device2_db.get_friends(user.id).unwrap();
    assert_eq!(friends.len(), 2, "Should have 2 friends after import");
}

