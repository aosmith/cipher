# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Node modules
node_modules/
npm-debug.log*
package-lock.json
/tests/e2e/node_modules/
/tests/e2e/package-lock.json

# Rust/Tauri build artifacts
/target/
/src-tauri/target/
# Note: Cargo.lock IS committed for applications (not ignored)

# Tauri generated mobile projects (regenerated via cargo tauri android/ios init)
/gen/

# Release binaries - too large for git, use GitHub Releases instead
# Keep README.md and CHANGELOG.md for documentation
/releases/**/*.dmg
/releases/**/*.deb
/releases/**/*.rpm
/releases/**/*.msi
/releases/**/*.exe
/releases/**/*.AppImage
/releases/**/checksums.txt
/releases/**/.DS_Store

# macOS
.DS_Store

# Apple certificates (keep locally, don't commit)
*.cer
aps.cer

# IDE files
.idea/
*.iml
.claude/settings.local.json

# Temporary and cache files
*.tmp
*.backup
*.bak
*~

# User uploads (contains user data/media - never commit)
/uploads/
/storage/

# Test coverage reports (generated files)
/coverage/
*.lcov

# Test artifacts (screenshots, recordings, etc.)
/tests/artifacts/
/tests/e2e/screenshots/
/tests/e2e/videos/

# Tauri capabilities configuration
/capabilities/
