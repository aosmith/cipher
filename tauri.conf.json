{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Cipher",
  "version": "0.1.7",
  "identifier": "com.cipher.social",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Cipher",
        "width": 1400,
        "minHeight": 720,
        "minWidth": 1024,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "copyright": "Copyright © 2025 Cipher Team",
    "shortDescription": "End-to-End Encrypted P2P Social Network", 
    "longDescription": "A zero-knowledge, end-to-end encrypted peer-to-peer social network built with Rust and Tauri. Share posts, images, and media with complete privacy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "targets": ["app", "dmg", "deb", "rpm"],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "iOS": {
      "developmentTeam": "2AYYQP7AV8"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "window": {
      "close": true,
      "hide": true,
      "show": true,
      "maximize": true,
      "minimize": true,
      "unmaximize": true,
      "unminimize": true,
      "startDragging": true
    },
    "notification": {},
    "dialog": {
      "ask": true,
      "confirm": true,
      "message": true,
      "open": true,
      "save": true
    },
    "clipboardManager": {
      "readText": true,
      "writeText": true
    },
    "globalShortcut": {},
    "theme": {
      "theme": true
    },
    "event": {
      "listen": true,
      "emit": true
    }
  }
}
