{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Cipher",
  "version": "0.1.2",
  "identifier": "com.cipher.social",
  "build": {
    "beforeDevCommand": "RAILS_ENV=android rails server -p 3001 -b 127.0.0.1",
    "beforeBuildCommand": "RAILS_ENV=android rails assets:precompile",
    "devUrl": "http://localhost:3001",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Cipher",
        "width": 1200,
        "minHeight": 600,
        "minWidth": 800,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "userAgent": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1"
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "copyright": "Copyright © 2025 Cipher Team",
    "shortDescription": "End-to-End Encrypted P2P Social Network", 
    "longDescription": "A zero-knowledge, end-to-end encrypted peer-to-peer social network built with Rails. Share posts, images, and media with complete privacy.",
    "resources": [
      "../app",
      "../config", 
      "../db",
      "../lib",
      "../Gemfile",
      "../Gemfile.lock",
      "../config.ru",
      "../bin/rails"
    ],
    "icon": [
      "icons/ios/icon_57.png",
      "icons/ios/icon_76.png",
      "icons/ios/icon_114.png",
      "icons/ios/icon_120.png",
      "icons/ios/icon_144.png",
      "icons/ios/icon_152.png",
      "icons/ios/icon_180.png",
      "icons/ios/icon_1024.png"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "iOS": {
      "developmentTeam": "XXXXXXXXXX"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "window": {
      "close": true,
      "hide": true,
      "show": true,
      "maximize": true,
      "minimize": true,
      "unmaximize": true,
      "unminimize": true,
      "startDragging": true
    },
    "notification": {},
    "dialog": {
      "ask": true,
      "confirm": true,
      "message": true,
      "open": true,
      "save": true
    },
    "clipboardManager": {
      "readText": true,
      "writeText": true
    },
    "globalShortcut": {}
  }
}