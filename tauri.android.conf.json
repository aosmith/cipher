{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Cipher",
  "version": "0.0.11",
  "identifier": "com.cipher.social",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "src"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Cipher",
        "width": 1200,
        "minHeight": 600,
        "minWidth": 800,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "userAgent": "Mozilla/5.0 (Linux; Android 14; Pixel 9) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": false,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "copyright": "Copyright © 2025 Cipher Team",
    "shortDescription": "End-to-End Encrypted P2P Social Network",
    "longDescription": "A zero-knowledge, end-to-end encrypted peer-to-peer social network built with Rust and Tauri. Share posts, images, and media with complete privacy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "targets": "all",
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "window": {
      "close": true,
      "hide": true,
      "show": true,
      "maximize": true,
      "minimize": true,
      "unmaximize": true,
      "unminimize": true,
      "startDragging": true
    },
    "notification": {},
    "dialog": {
      "ask": true,
      "confirm": true,
      "message": true,
      "open": true,
      "save": true
    },
    "clipboardManager": {
      "readText": true,
      "writeText": true
    },
    "globalShortcut": {}
  }
}
